<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BottomNavigationView.Active" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/nunito_sans_bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="BottomNavigationView.Inactive" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/nunito_sans_regular</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:textViewStyle">@style/Widget.Typography.TextView</item>
    </style>

<!--    Text Style-->
    <style name="Widget.Typography.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/show_plus_font</item>
    </style>

    <style name="TextAppearance.App.HeadlineLarge" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.App.TitleLarge1" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_semi_bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.App.TitleLarge2" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.App.Title1" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.App.Title2" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.App.Body1" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.App.Body2" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.App.Bodysml" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.App.Label" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/nunito_sans_semi_bold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>